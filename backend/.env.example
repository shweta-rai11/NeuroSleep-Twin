# Copy to .env and fill in for local development.

APP_NAME="NeuroSleep Twin API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call this API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (metadata: studies, events, phenotypes, models, reports...)
DATABASE_URL=postgresql+psycopg2://neurosleep:neurosleep@localhost:5432/neurosleep

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (raw/processed waveforms, reports)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=neurosleep-twin
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Research Assistant (Phase 15) — Ollama (local, no key) is tried first, then
# Anthropic if a key is set, then template-based narration as the final fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=

# Required Bearer token for every request except /health, once set (README §11/§18).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank for zero-friction local dev; the frontend must be given the same value
# via frontend/.env's VITE_API_TOKEN.
API_AUTH_TOKEN=
