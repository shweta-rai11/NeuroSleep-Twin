# Copy to .env for local development.

# Must match backend .env's API_AUTH_TOKEN exactly. Leave both blank for
# zero-friction local dev with no auth.
VITE_API_TOKEN=

# Leave blank locally — the Vite dev proxy forwards /api to the backend (see
# vite.config.ts). Set this to the backend's real URL (e.g.
# https://neurosleep-twin-api.onrender.com/api/v1) for a split deploy where
# frontend and backend aren't on the same origin.
VITE_API_BASE_URL=
